# ignore build dir
build*/

# ignore all dotfiles
./.*

# except these
!.gitignore
!.github/

# ignore IDE project files
*.kdev4
*.workspace

# ignore Qt generated files
*.qmlc
*.jsc
*.autosave

# Bundled cores are downloaded by etc/android/fetch-bundled-cores.sh and are not tracked
src/app/platform/android/libs/
src/app/platform/android/assets/packs/
