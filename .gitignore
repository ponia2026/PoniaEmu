# ignore build dir
build*/

# ignore all dotfiles
./.*

# except these
!.gitignore
!.qmake.conf
!.appveyor.yml
!.circleci/
!.travis/
!.github/

# ignore IDE project files
*.pro.user
*.kdev4
*.workspace

# ignore Qt generated files
*.qmlc
*.jsc
*.autosave

# 内建核心由 etc/android/fetch-bundled-cores.sh 下载，不进版控
src/app/platform/android/libs/
src/app/platform/android/assets/packs/
